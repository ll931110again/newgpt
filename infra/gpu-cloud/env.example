# NEVER commit real secrets. Copy to .env (ignored) or export in your shell.

# Lambda Cloud API (for infra/gpu-cloud/lambda/*.sh)
# Required on the GPU VM .env for auto-terminate after training (remote_watch_and_teardown.sh).
LAMBDA_API_KEY=__SET_ME__
# Set to 0 on the VM to keep the instance running after training (debugging).
# AUTO_TERMINATE=1
# Optional overrides for provision.sh:
# LAMBDA_INSTANCE_TYPE=auto
# LAMBDA_REGION=auto
# LAMBDA_SSH_KEY_NAME=
# LAMBDA_INSTANCE_NAME=pretrainer-pretrain
# LAMBDA_SSH_PRIVATE_KEY=~/.ssh/id_ed25519

# S3-compatible storage for datasets/checkpoints (recommended)
S3_ENDPOINT_URL=
S3_BUCKET=__SET_ME__
S3_PREFIX=pretrainer
AWS_ACCESS_KEY_ID=__SET_ME__
AWS_SECRET_ACCESS_KEY=__SET_ME__
AWS_DEFAULT_REGION=us-east-1

# Experiment tracking (enables W&B when set — see docs/22_monitoring.md)
WANDB_API_KEY=
WANDB_PROJECT=pretrainer
WANDB_ENTITY=

# mlop.ai monitoring (https://app.mlop.ai — see docs/22_monitoring.md)
MLOP_API_KEY=
MLOP_PROJECT=pretrainer

# Hugging Face (optional for pushing/pulling)
HF_TOKEN=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Paperspace (https://console.paperspace.com/account/api)
PAPERSPACE_API_KEY=
PAPERSPACE_TEAM_ID=
PAPERSPACE_PROJECT_ID=

# Lightning AI (https://lightning.ai/me/settings/keys)
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
LIGHTNING_USERNAME=
LIGHTNING_TEAMSPACE=
# Optional:
# LIGHTNING_ORG=
# LIGHTNING_MACHINE=T4
# Git repo cloned into the remote notebook workspace
PAPERSPACE_WORKSPACE_GIT=https://github.com/ll931110again/newgpt.git

# Kaggle (for infra/kaggle — see scripts/kaggle_train.sh)
KAGGLE_API_TOKEN=
# Corpus (pick one — see below):
#   wikitext103  default; ~103M tok, ~1 epoch per 9h T4 run  ← current v6 run
#   c4_250k      slightly larger; good if you want more diversity without long prep
#   c4_1m        largest; fresh run only, ~1h prep + partial epoch in 9h
KAGGLE_DATASET=wikitext103
# GPU session budget for step cap (Kaggle free tier ≈ 9h per run)
KAGGLE_TRAIN_HOURS=9
# Detached workflow: ./scripts/kaggle_train.sh start  then  ./scripts/kaggle_train.sh resume
# KAGGLE_DETACH=1

